# The site's public origin, used for canonical URLs, the sitemap, robots.txt, llms.txt and the
# social image. On Vercel it falls back to the production domain when unset.
NEXT_PUBLIC_SITE_URL=https://example.com

# The trailer on the landing page: a YouTube video id or URL. Unset shows a placeholder.
NEXT_PUBLIC_TRAILER_YOUTUBE_ID=

# Optional: a GitHub token for the release lookup (the unauthenticated limit is 60 requests an
# hour per IP; the lookup is cached for an hour, so this is rarely needed).
GITHUB_TOKEN=
