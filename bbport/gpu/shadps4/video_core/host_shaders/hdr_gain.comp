// bbport: scene HDR (vk_scene_hdr.h), step 2: per pixel, how much brighter than the SDR picture
// a highlight gets. Two sources, the larger wins: the highlight expansion of the UI-free SDR
// scene (hdr_highlight.glsl, the same curve the presenter uses without a gain map), and how much
// brighter the game's 16-bit scene had it at the frame's mid-tone exposure (Bloodborne's scene
// rarely holds much above SDR white, so this mostly adds to small lamps and flames). Where the UI
// was drawn (the frame differs clearly from its copy without UI) the gain stays 1. The display
// pass may apply the game's brightness curve, so small differences are not UI.
// Output: r = gain over the SDR picture's linear color, g = UI coverage (debug).
#version 450
#extension GL_GOOGLE_include_directive : require

#include "hdr_highlight.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D scene;
layout(binding = 1) uniform sampler2D hudless;
layout(binding = 2) uniform sampler2D display; ///< the game's finished frame, UI included
layout(std430, binding = 3) readonly buffer Exposure {
    float log_ratio;
    float valid;
};
layout(binding = 4, rg16f) uniform writeonly image2D gain;

layout(push_constant) uniform Params {
    float headroom;    ///< peak / paper white
    float highlights;  ///< 0..1, hdr_highlights
    uint decode_srgb;
    uint has_hudless;  ///< 0: no UI copy this frame (no UI drawn), the display is UI-free
};

vec3 SrgbToLinear(vec3 c) {
    return mix(pow((c + 0.055) / 1.055, vec3(2.4)), c / 12.92, lessThanEqual(c, vec3(0.04045)));
}

vec3 Read(sampler2D image, vec2 uv) {
    const vec3 c = textureLod(image, uv, 0.0).rgb;
    return decode_srgb != 0u ? SrgbToLinear(c) : c;
}

float Luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(gain);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    const vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    const vec3 frame = Read(display, uv);
    const vec3 clean = has_hudless != 0u ? Read(hudless, uv) : frame;
    // Compared gamma encoded, so a faint UI shadow over a dark scene counts as much as one over
    // a bright one.
    const vec3 diff = abs(pow(frame, vec3(1.0 / 2.2)) - pow(clean, vec3(1.0 / 2.2)));
    const float ui = smoothstep(0.10, 0.25, max(max(diff.r, diff.g), diff.b));
    const float ls = Luma(clean);
    const float expand = HighlightGain(ls, headroom, highlights);
    if (valid < 0.5 || highlights <= 0.0) {
        imageStore(gain, pixel, vec4(mix(expand, 1.0, ui), ui, 0.0, 0.0));
        return;
    }
    // A small box filter: the scene is jittered and not anti-aliased yet at some presets.
    const vec2 texel = 0.5 / vec2(textureSize(scene, 0));
    const vec3 hdr = 0.25 * (textureLod(scene, uv + vec2(-texel.x, -texel.y), 0.0).rgb +
                             textureLod(scene, uv + vec2(texel.x, -texel.y), 0.0).rgb +
                             textureLod(scene, uv + vec2(-texel.x, texel.y), 0.0).rgb +
                             textureLod(scene, uv + vec2(texel.x, texel.y), 0.0).rgb);
    float lh = Luma(max(hdr, vec3(0.0))) * exp(log_ratio);
    if (isnan(lh) || isinf(lh)) {
        lh = 0.0;
    }
    // Only toward white, where the tonemap's shoulder squeezes: the mid-tones keep the game's
    // grading exactly.
    const float g = clamp(lh / max(ls, 1e-4), 1.0, headroom);
    const float scene_gain = exp(log(g) * smoothstep(0.25, 0.8, ls));
    // At most the peak (the expansion takes the game's lights there, past `headroom` times).
    const float value = min(max(expand, scene_gain), max(headroom / max(ls, 1e-4), 1.0));
    imageStore(gain, pixel, vec4(mix(value, 1.0, ui), ui, 0.0, 0.0));
}
